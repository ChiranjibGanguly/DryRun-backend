PORT=3000
CORS_ORIGIN=*

# Format: postgresql://USER:PASSWORD@localhost:5432/dryrun (omit :PASSWORD if your server needs none)
DATABASE_URL=postgresql://chiranjibganguly@localhost:5432/dryrun

# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Admin account created by `npm run seed`
ADMIN_EMAIL=admin@dryrun.local
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Store Admin

# Where uploaded book covers are stored (served at /uploads)
UPLOAD_DIR=uploads

# Shipping (paise): flat fee, free from this order value upwards
SHIPPING_FEE_PAISE=4900
FREE_SHIPPING_MIN_PAISE=49900

# Razorpay (use TEST keys from dashboard.razorpay.com > Settings > API Keys).
# Online payment stays switched off until both keys are set; cash on delivery always works.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks: URL https://<your-api>/api/payments/webhook, events payment.captured + order.paid
RAZORPAY_WEBHOOK_SECRET=

# Emails (order confirmation, shipped, cancelled). Without a key they are printed
# to the console. Get a key at https://resend.com and verify your sending domain.
RESEND_API_KEY=
EMAIL_FROM=DryRun Books <orders@example.com>
# Web app address used in email links
SHOP_URL=http://localhost:8080

# Security
# Comma-separated web app addresses allowed to call the API (required in production)
# CORS_ORIGIN=https://dryrunbooks.in,https://admin.dryrunbooks.in
# Behind Render/Railway/Nginx set to 1 so rate limits see real client IPs
TRUST_PROXY=
# Requests per IP per window (minutes)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_AUTH=20
RATE_LIMIT_API=1500
